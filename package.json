{
  "name": "sdk-transparencia-br",
  "version": "1.0.5",
  "description": "SDK TypeScript para API do Portal da Transparência",
  "keywords": [
    "portal-da-transparencia",
    "transparencia",
    "dados-abertos",
    "governo-federal",
    "api",
    "sdk",
    "typescript",
    "beneficios",
    "servidores",
    "contratos"
  ],
  "author": "guio11221 <sguii5147@gmail.com> (https://github.com/guio11221)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guio11221/transparencia-br.git"
  },
  "bugs": {
    "url": "https://github.com/guio11221/transparencia-br/issues"
  },
  "homepage": "https://github.com/guio11221/transparencia-br#readme",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pack:check": "npm pack --dry-run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "zod": "^3.24.0"
  },
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
